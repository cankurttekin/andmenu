<resources>
    <!-- Gruvbox -->
    <style name="AppThemeGruvbox" parent="Theme.AppCompat.NoActionBar">
        <item name="android:colorBackground">@color/gruvbox_bg</item>
        <item name="android:textColor">@color/gruvbox_fg</item>
        <item name="andmenuAccentColor">@color/gruvbox_accent</item>
        <item name="andmenuBaseTextColor">@color/gruvbox_fg</item>
        <item name="andmenuFrameColor">@color/gruvbox_command_bg</item>
        <item name="andmenuFrameTextColor">@color/gruvbox_fg</item>
        <item name="andmenuSelectedItemBackgroundColor">@color/gruvbox_selected</item>
        <item name="andmenuBackgroundColorOfCommand">@color/gruvbox_command_bg</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="AppThemeGruvboxHome" parent="AppThemeGruvbox">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

