    <!-- Help -->
    <string name="app_help_text">
        Android uygulama başlatıcısı ve komut menüsü

        \n
        \nKULLANIM
        \n-&#032;Uygulamaları, komutları veya desteklenen diğer içerikleri aramak için bir sorgu girin.
        \n
        \nARAMA
        \n-&#032;Uygulama adının bir kısmı
        \n-&#032;Paket adının bir kısmı
        \n-&#032;URL
        \n-&#032;Telefon numarası
        \n-&#032;E-posta adresi
        \n-&#032;m &lt;sorgu&gt; - Müzik
        \n-&#032;c &lt;sorgu&gt; - Kişiler
        \n-&#032;b &lt;sorgu&gt; - Yer İmleri
        \n-&#032;n &lt;sorgu&gt; - Notlar ve Yapılacaklar
        \n-&#032;rss &lt;sorgu&gt; - RSS besleme okuyucu
        \n-&#032;ip&#032;- Yerel ağ IP ve MAC adresi
        \n-&#032;dns &lt;alan_adı&gt; - DNS sorgulama
        \n-&#032;ping &lt;sunucu&gt; - Sunucuya ping atma
        \n-&#032;gen pass &lt;uzunluk&gt; - Parola oluşturucu
        \n-&#032;b64enc / b64dec - Base64 kodlayıcı/çözücü
        \n-&#032;uuid - Rastgele UUIDv4 oluşturucu
        \n-&#032;hash &lt;metin&gt; - MD5 / SHA256 özetleri
        \n-&#032;define &lt;kelime&gt; - Sözlük anlamları
        \n-&#032;Hesaplama formülü
        \n
        \nÖRNEKLER
        \n-&#032;m joy division
        \n-&#032;c alan turing
        \n-&#032;b github
        \n-&#032;n market alışverişi
        \n-&#032;define ubiquitous
        \n-&#032;ip&#032;
        \n-&#032;gen pass 20
        \n-&#032;b64enc merhaba
        \n-&#032;uuid
        \n-&#032;hash metin
        \n-&#032;ornek@ornek.com
        \n-&#032;(8+6)*3
        \n-&#032;1inch in cm
        \n-&#032;1m+1inch in cm
        \n-&#032;https://example.com/
        \n-&#032;+1234567890
        \n
        \nKOMUTLAR
        \n-&#032;help
        \n-&#032;config
        \n-&#032;date
